# Copy to .env and fill in. .env is ignored by git and kept out of the Docker image;
# docker compose and the local app (dwg-sheets, dwg-sheets-web) read it at start.

# Turns on the AI agent that finds each drawing's title and scale patterns.
# Every upload to the web app then makes a paid OpenRouter call (about USD 0.03-0.12 per new drawing with Sonnet).
OPENROUTER_API_KEY=
# Any OpenRouter model with tool calls. Empty: anthropic/claude-sonnet-5.5
OPENROUTER_MODEL=

# Require this password on the web app (HTTP Basic, any user name).
APP_PASSWORD=
